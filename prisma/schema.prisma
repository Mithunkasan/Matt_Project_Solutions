generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  role      Role      @default(STUDENT)
  accounts  Account[]
  sessions  Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Project {
  id              String        @id @default(cuid())
  name            String
  college         String
  department      String
  handler         String
  handlerEmail    String?
  team            String
  student         String
  date            DateTime
  amountPaid      Float
  finalAmount     Float
  paymentProgress Int
  status          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  studentEmail    String?
  files           ProjectFile[]
  progressUpdates ProjectProgressUpdate[]
  sharedFiles     SharedStudentFile[]

  @@map("projects")
}

model ClassSchedule {
  id           String   @id @default(cuid())
  project      String
  day          String
  date         DateTime
  time         String
  faculty      String
  location     String
  department   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  studentEmail String?
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("class_schedules")
}

model workshops {
  id          String   @id
  title       String
  description String?
  college     String
  department  String
  organizer   String
  team        String
  date        DateTime
  duration    String
  location    String
  attendees   Int
  status      String
  fee         Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

enum Role {
  ADMIN
  PROJECT_HANDLER
  STUDENT
}

model ProjectHandlerInvite {
  id        String    @id @default(cuid())
  email     String
  name      String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("project_handler_invites")
}

model InternshipApplication {
  id          String   @id @default(cuid())
  fullName    String
  collegeName String
  department  String?
  yearOfStudy String
  email       String
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("internship_applications")
}

model ImportantLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("important_links")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  month     String
  day       String
  href      String   @default("/browse")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model Offer {
  id        String   @id @default(cuid())
  text      String
  link      String?  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offers")
}

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  name       String   // e.g. "Proposal", "Synopsis", "Source Code", etc.
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model SharedStudentFile {
  id           String   @id @default(cuid())
  projectId    String
  studentEmail String
  handlerEmail String
  fileName     String
  fileUrl      String
  fileType     String
  message      String?
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("shared_student_files")
}

model ProjectProgressUpdate {
  id           String   @id @default(cuid())
  projectId    String
  studentEmail String
  handlerEmail String
  status       String
  progress     Int
  title        String
  details      String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_progress_updates")
}

model HandlerWorkshop {
  id               String   @id @default(cuid())
  date             DateTime
  time             String
  handlerEmail     String
  handlerName      String
  participantNames String
  college          String
  department       String
  topic            String
  duration         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("handler_workshops")
}

model Course {
  id          String             @id @default(cuid())
  name        String
  description String?
  department  String
  duration    String
  faculty     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  enrollments CourseEnrollment[]
  schedules   ClassSchedule[]

  @@map("courses")
}

model CourseEnrollment {
  id           String   @id @default(cuid())
  courseId     String
  studentEmail String
  studentName  String
  progress     Int      @default(0)
  status       String   @default("Active") // Active, Completed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentEmail])
  @@map("course_enrollments")
}

model ChatMessage {
  id           String   @id @default(cuid())
  studentEmail String
  senderRole   Role     // ADMIN or STUDENT
  message      String
  fileUrl      String?
  fileName     String?
  fileType     String?  // "image", "audio", "document" etc.
  createdAt    DateTime @default(now())

  @@map("chat_messages")
}

model Notification {
  id           String   @id @default(cuid())
  studentEmail String
  title        String
  message      String
  type         String   // STATUS, PAYMENT, MEETING, VIVA, FILE
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("notifications")
}

model Meeting {
  id           String   @id @default(cuid())
  studentEmail String
  title        String
  date         DateTime
  time         String
  meetLink     String
  type         String   // PROJECT or COURSE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("meetings")
}
